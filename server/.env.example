# ===== 服务端口 =====
PORT=3000

# ===== LLM Agent（OpenAI 兼容接口，可选）=====
# 未配置 LLM_API_KEY 时自动降级为规则引擎 Mock 模式，全流程仍可跑通
# DeepSeek:  LLM_BASE_URL=https://api.deepseek.com    LLM_MODEL=deepseek-chat
# Kimi:      LLM_BASE_URL=https://api.moonshot.cn/v1  LLM_MODEL=moonshot-v1-8k
# 智谱GLM:   LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4  LLM_MODEL=glm-4-flash
# OpenAI:    LLM_BASE_URL=https://api.openai.com/v1   LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ===== Agent 调用 =====
LLM_TIMEOUT_MS=60000
